# Polymarket Hub — Phase 2 environment variables
# Copy this file to .env (which is git-ignored) and fill in values.

# Storage backend for the paper trader.
#   'idb' (default) — use browser IndexedDB. Single-device, single-user, tab-must-be-open.
#   'api'           — use Supabase. Multi-device team-code, requires the two values below.
VITE_STORAGE_MODE=idb

# Supabase (only required when VITE_STORAGE_MODE=api)
# Find these in your Supabase project Dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
